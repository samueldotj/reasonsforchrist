---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import data from '../../../data/books.json';
import { getCover, getAsset } from '../../lib/images';

export function getStaticPaths() {
  return data.books.map((book) => ({
    params: { slug: book.slug },
    props: { book },
  }));
}

const { book } = Astro.props;
const { author } = data;
const cover = getCover(book.coverImage);
const authorPhoto = getAsset(author.photo);
const pageTitle = book.subtitle ? `${book.title} — ${book.subtitle}` : book.title;
const published = book.publishedDate
  ? new Date(book.publishedDate).toLocaleDateString('en-US', {
      month: 'long',
      day: 'numeric',
      year: 'numeric',
      timeZone: 'UTC',
    })
  : undefined;
---

<Layout title={pageTitle} description={book.description} ogImage={cover}>
  <main>
    <div class="bg-sky">
      <div class="mx-auto flex max-w-6xl flex-col gap-8 px-5 pt-6 pb-16 sm:px-8 lg:pb-24">
        <a href="/#books" class="inline-flex min-h-11 items-center gap-2 self-start text-[15px] font-semibold text-forest hover:underline">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 12H5" /><path d="m11 6-6 6 6 6" />
          </svg>
          All books
        </a>

        <article class="flex flex-wrap items-center gap-10 lg:gap-18">
          <div class="flex min-w-0 flex-[1_1_300px] justify-center">
            <Image
              src={cover}
              alt={`Cover of ${book.title}`}
              width={760}
              widths={[380, 570, 760]}
              sizes="(max-width: 640px) 70vw, 380px"
              loading="eager"
              fetchpriority="high"
              class="h-auto w-[70%] max-w-[380px] drop-shadow-[0_28px_36px_rgba(23,35,28,0.3)] sm:w-full"
            />
          </div>
          <div class="flex min-w-0 flex-[999_1_460px] flex-col gap-5">
            <p class="text-[13px] font-semibold uppercase tracking-[0.12em] text-[#8a4b0f]">
              By {author.name}{published && ` · Published ${published}`}
            </p>
            <h1 class="font-serif text-[44px] leading-[1.02] font-medium tracking-tight sm:text-[60px] lg:text-[72px]">{book.title}</h1>
            {book.subtitle && (
              <p class="font-serif text-[22px] leading-snug text-[#2e3b33] sm:text-[26px]">{book.subtitle}</p>
            )}
            <p class="max-w-2xl text-[#2e3b33]">{book.description}</p>
            <div class="mt-3 flex flex-wrap gap-3">
              <a
                href={book.heyzineUrl}
                target="_blank"
                rel="noopener noreferrer"
                data-track="read_online_click"
                data-book={book.slug}
                class="inline-flex min-h-14 items-center justify-center gap-2.5 rounded-full bg-forest px-8 font-semibold text-white transition hover:bg-forest-dark"
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M2 5h7a3 3 0 0 1 3 3v12a2 2 0 0 0-2-2H2z" /><path d="M22 5h-7a3 3 0 0 0-3 3v12a2 2 0 0 1 2-2h8z" />
                </svg>
                Read free online
              </a>
              {book.amazonUrl && (
                <a
                  href={book.amazonUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-track="buy_book_click"
                  data-book={book.slug}
                  class="inline-flex min-h-14 items-center justify-center rounded-full border-[1.5px] border-[#9fb3a6] bg-white px-8 font-semibold text-ink transition hover:bg-paper"
                >
                  Buy the printed book
                </a>
              )}
            </div>
            <p class="text-[15px] text-[#3d4a42]">Reading online is completely free — no sign-up needed.</p>
          </div>
        </article>
      </div>
    </div>

    <section class="mx-auto max-w-6xl px-5 py-14 sm:px-8 lg:py-20">
      <div class="flex flex-wrap items-center justify-between gap-6 rounded-3xl bg-ink px-6 py-8 text-[#eef2ef] sm:px-10">
        <div class="flex items-center gap-5">
          <Image
            src={authorPhoto}
            alt={`Photo of ${author.name}`}
            width={72}
            densities={[1, 2]}
            class="size-18 shrink-0 rounded-full object-cover object-top"
            loading="lazy"
          />
          <div class="flex flex-col">
            <span class="font-serif text-[22px] text-white">Questions about this book?</span>
            <span class="text-[15px] text-[#a9b6ad]">{author.contactText}.</span>
          </div>
        </div>
        <a
          href={`mailto:${author.email}`}
          data-track="email_click"
          data-book={book.slug}
          class="inline-flex min-h-12 items-center rounded-full bg-sand px-6 text-[15px] font-semibold break-all text-ink transition hover:bg-[#f6d3a6]"
        >
          {author.email}
        </a>
      </div>
    </section>
  </main>
</Layout>
