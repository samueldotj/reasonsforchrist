---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import data from '../../../data/books.json';
import { getCover } from '../../lib/images';

export function getStaticPaths() {
  return data.books.map((book) => ({
    params: { slug: book.slug },
    props: { book },
  }));
}

const { book } = Astro.props;
const cover = getCover(book.coverImage);
const pageTitle = book.subtitle ? `${book.title} — ${book.subtitle}` : book.title;
---

<Layout title={pageTitle} description={book.description} ogImage={cover.src}>
  <main class="mx-auto max-w-4xl px-4 sm:px-6">
    <nav class="py-6">
      <a href="/" class="text-sm font-medium text-stone-500 hover:text-stone-800">
        &larr; All books
      </a>
    </nav>

    <article class="flex flex-col gap-10 pb-12 sm:flex-row">
      <Image
        src={cover}
        alt={`Cover of ${book.title}`}
        width={448}
        widths={[224, 448, 672]}
        sizes="(max-width: 640px) 14rem, 16rem"
        loading="eager"
        fetchpriority="high"
        class="mx-auto aspect-[2/3] w-56 shrink-0 rounded-lg object-cover shadow-lg sm:mx-0 sm:w-64"
      />
      <div class="flex flex-col">
        <h1 class="text-3xl font-bold tracking-tight text-stone-900">{book.title}</h1>
        {book.subtitle && (
          <p class="mt-2 text-lg font-medium text-stone-500">{book.subtitle}</p>
        )}
        <p class="mt-5 leading-relaxed text-stone-700">{book.description}</p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a
            href={book.heyzineUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-track="read_online_click"
            data-book={book.slug}
            class="inline-flex items-center justify-center rounded-lg bg-emerald-700 px-6 py-3 font-semibold text-white shadow-sm transition hover:bg-emerald-800"
          >
            Read free online
          </a>
          {book.amazonUrl && (
            <a
              href={book.amazonUrl}
              target="_blank"
              rel="noopener noreferrer"
              data-track="buy_book_click"
              data-book={book.slug}
              class="inline-flex items-center justify-center rounded-lg border border-stone-300 bg-white px-6 py-3 font-semibold text-stone-800 shadow-sm transition hover:bg-stone-100"
            >
              Buy printed book
            </a>
          )}
        </div>
        <p class="mt-4 text-sm text-stone-500">
          Reading online is completely free — no sign-up needed.
        </p>
      </div>
    </article>
  </main>
</Layout>
