---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import data from '../../data/books.json';
import { getCover, getAsset } from '../lib/images';

const { books, author } = data;
const authorPhoto = getAsset(author.photo);
const sortedBooks = [...books].sort((a, b) =>
  (b.publishedDate ?? '').localeCompare(a.publishedDate ?? '')
);
const latest = sortedBooks[0];

const monthYear = (date?: string) =>
  date
    ? new Date(date).toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' })
    : undefined;

const primaryButton =
  'inline-flex min-h-12 items-center justify-center gap-2.5 rounded-full bg-forest px-6 text-[15px] font-semibold text-white transition hover:bg-forest-dark';
const secondaryButton =
  'inline-flex min-h-12 items-center justify-center rounded-full border-[1.5px] border-outline bg-white/60 px-6 text-[15px] font-semibold text-ink transition hover:bg-white';
const eyebrow = 'text-[13px] font-semibold uppercase tracking-[0.12em] text-ochre';
---

<Layout
  title="Reasons for Christ — Free Books"
  description="Books on the reasons for believing in Christ — free to read online, printed copies available on Amazon."
  ogImage={latest ? getCover(latest.coverImage) : undefined}
>
  <main>
    <!-- Mission -->
    <section class="mx-auto flex max-w-6xl flex-wrap items-center gap-12 px-5 py-14 sm:px-8 lg:gap-16 lg:py-24">
      <div class="flex min-w-0 flex-[1_1_440px] flex-col gap-6">
        <p class={eyebrow}>Free books · Read online, no sign-up</p>
        <h1 class="font-serif text-[40px] leading-[1.06] font-medium tracking-tight sm:text-[56px] lg:text-[68px] lg:leading-[1.04]">
          The reasons I believe, written down and given away.
        </h1>
        <p class="max-w-xl text-lg leading-relaxed text-muted sm:text-[19px]">
          Here I deposit all the reasons for believing in Christ in the form of books — to strengthen
          and edify fellow believers, and to give an answer for why I believe.
        </p>
        {latest && (
          <div class="mt-1 flex flex-wrap gap-3">
            <a
              href={latest.heyzineUrl}
              target="_blank"
              rel="noopener noreferrer"
              data-track="read_online_click"
              data-book={latest.slug}
              class={`${primaryButton} min-h-13 px-7 text-base`}
            >
              Read the latest book free
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14" /><path d="m13 6 6 6-6 6" />
              </svg>
            </a>
            <a href="#books" class={`${secondaryButton} min-h-13 px-7 text-base`}>Browse all books</a>
          </div>
        )}
      </div>

      {latest && (
        <div class="flex min-w-0 flex-[1_1_360px] justify-center">
          <div class="relative flex aspect-[1/1.08] w-full max-w-[480px] items-center justify-center overflow-hidden rounded-[28px] bg-sky">
            <div class="absolute -top-14 -right-14 size-52 rounded-full bg-sand" aria-hidden="true"></div>
            <Image
              src={getCover(latest.coverImage)}
              alt={`Cover of ${latest.title}`}
              width={640}
              widths={[320, 480, 640]}
              sizes="(max-width: 640px) 60vw, 320px"
              loading="eager"
              fetchpriority="high"
              class="relative h-auto w-[66%] drop-shadow-[0_24px_32px_rgba(23,35,28,0.28)]"
            />
          </div>
        </div>
      )}
    </section>

    <!-- Books -->
    <section id="books" aria-labelledby="books-heading" class="scroll-mt-4 border-y border-line bg-white">
      <div class="mx-auto flex max-w-6xl flex-col gap-10 px-5 py-14 sm:px-8 lg:py-20">
        <div class="flex flex-wrap items-baseline justify-between gap-3">
          <h2 id="books-heading" class="font-serif text-[32px] font-medium tracking-tight sm:text-[44px]">The books</h2>
          <p class="text-[15px] text-soft">Every book is free to read online. Printed copies are on Amazon.</p>
        </div>

        {sortedBooks.map((book, i) => (
          <article class="flex flex-wrap items-center gap-8 rounded-3xl bg-paper p-6 sm:gap-12 sm:p-10">
            <a href={`/books/${book.slug}/`} class="mx-auto block w-44 shrink-0 sm:mx-0 sm:w-60">
              <Image
                src={getCover(book.coverImage)}
                alt={`Cover of ${book.title}`}
                width={480}
                widths={[240, 480]}
                sizes="(max-width: 640px) 11rem, 15rem"
                loading="lazy"
                class="h-auto w-full"
              />
            </a>
            <div class="flex min-w-0 flex-[999_1_400px] flex-col gap-4">
              {(i === 0 || book.publishedDate) && (
                <p class={eyebrow}>
                  {[i === 0 ? 'Latest' : undefined, monthYear(book.publishedDate)].filter(Boolean).join(' · ')}
                </p>
              )}
              <h3 class="font-serif text-[30px] leading-[1.1] font-medium tracking-tight sm:text-[40px]">
                <a href={`/books/${book.slug}/`} class="text-ink hover:underline">{book.title}</a>
              </h3>
              {book.subtitle && <p class="text-lg font-medium text-muted">{book.subtitle}</p>}
              <p class="max-w-2xl text-muted">{book.description}</p>
              <div class="mt-2 flex flex-wrap gap-3">
                <a
                  href={book.heyzineUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-track="read_online_click"
                  data-book={book.slug}
                  class={primaryButton}
                >
                  Read free online
                </a>
                {book.amazonUrl && (
                  <a
                    href={book.amazonUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-track="buy_book_click"
                    data-book={book.slug}
                    class={secondaryButton}
                  >
                    Buy the printed book
                  </a>
                )}
                <a href={`/books/${book.slug}/`} class="inline-flex min-h-12 items-center px-3 text-[15px] font-semibold text-forest hover:underline">
                  Details
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Ways to read -->
    <section aria-labelledby="ways-heading" class="mx-auto flex max-w-6xl flex-col gap-8 px-5 py-14 sm:px-8 lg:py-20">
      <h2 id="ways-heading" class="font-serif text-[28px] font-medium tracking-tight sm:text-4xl">Three ways to read</h2>
      <div class="grid gap-5 md:grid-cols-3">
        <div class="flex flex-col gap-3 rounded-[20px] border border-line bg-white p-7">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="text-forest" aria-hidden="true">
            <path d="M2 5h7a3 3 0 0 1 3 3v12a2 2 0 0 0-2-2H2z" /><path d="M22 5h-7a3 3 0 0 0-3 3v12a2 2 0 0 1 2-2h8z" />
          </svg>
          <h3 class="text-[19px] font-semibold">Read free online</h3>
          <p class="text-base text-soft">Open the full book as a flipbook in your browser. No account, no email, no cost.</p>
        </div>
        <div class="flex flex-col gap-3 rounded-[20px] border border-line bg-white p-7">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="text-forest" aria-hidden="true">
            <path d="M6 2h12v20l-6-4-6 4z" />
          </svg>
          <h3 class="text-[19px] font-semibold">Hold a printed copy</h3>
          <p class="text-base text-soft">Prefer paper, or want one to give away? Printed editions are available on Amazon.</p>
        </div>
        <div class="flex flex-col gap-3 rounded-[20px] border border-line bg-white p-7">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="text-forest" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" />
          </svg>
          <h3 class="text-[19px] font-semibold">Ask a question</h3>
          <p class="text-base text-soft">Something in a book raise a question? Write to me directly.</p>
        </div>
      </div>
    </section>

    <!-- Author -->
    <section id="about" aria-labelledby="about-heading" class="scroll-mt-4 bg-ink text-[#eef2ef]">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-10 px-5 py-16 sm:px-8 lg:gap-14 lg:py-24">
        <Image
          src={authorPhoto}
          alt={`Photo of ${author.name}`}
          width={260}
          densities={[1, 2]}
          class="h-32 w-32 shrink-0 rounded-full object-cover object-top sm:h-[300px] sm:w-[260px] sm:rounded-[20px]"
          loading="lazy"
        />
        <div class="flex min-w-0 flex-[999_1_400px] flex-col gap-4">
          <p class="text-[13px] font-semibold uppercase tracking-[0.12em] text-sand">About the author</p>
          <h2 id="about-heading" class="font-serif text-[32px] font-medium tracking-tight text-white sm:text-[44px]">{author.name}</h2>
          {author.intro.map((line) => <p class="max-w-2xl text-[#c9d3cc]">{line}</p>)}
          <div class="mt-2 flex flex-wrap items-center gap-4">
            <a
              href={`mailto:${author.email}`}
              data-track="email_click"
              class="inline-flex min-h-12 items-center gap-2.5 rounded-full bg-sand px-6 text-[15px] font-semibold text-ink transition hover:bg-[#f6d3a6]"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" />
              </svg>
              {author.email}
            </a>
            <span class="text-[15px] text-[#a9b6ad]">{author.contactText}</span>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
