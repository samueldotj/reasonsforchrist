---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import data from '../../data/books.json';
import { getCover, getAsset } from '../lib/images';

const { books, author } = data;
const authorPhoto = getAsset(author.photo);
const sortedBooks = [...books].sort((a, b) =>
  (b.publishedDate ?? '').localeCompare(a.publishedDate ?? '')
);
---

<Layout
  title="Reasons for Christ — Free Books"
  description="Books on the reasons for believing in Christ — free to read online, printed copies available on Amazon."
  ogImage={sortedBooks.length ? getCover(sortedBooks[0].coverImage) : undefined}
>
  <main class="mx-auto max-w-5xl px-4 sm:px-6">
    <!-- Mission -->
    <section class="py-12 text-center sm:py-16">
      <h1 class="text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl">
        Reasons for Christ
      </h1>
      <p class="mx-auto mt-6 max-w-3xl text-lg leading-relaxed text-stone-600">
        Here I deposit all the reasons for believing in Christ in the form of books
        to strengthen and edify fellow believers and also to provide the answer for
        the reason why I believe.
      </p>
    </section>

    <!-- Books -->
    <section aria-labelledby="books-heading">
      <h2 id="books-heading" class="sr-only">Books</h2>
      <div class="flex flex-wrap justify-center gap-8">
        {sortedBooks.map((book) => (
          <a
            href={`/books/${book.slug}/`}
            class="group flex w-full max-w-sm flex-col overflow-hidden rounded-xl border border-stone-200 bg-white shadow-sm transition hover:shadow-md sm:w-72"
          >
            <Image
              src={getCover(book.coverImage)}
              alt={`Cover of ${book.title}`}
              width={640}
              widths={[320, 480, 640, 960]}
              sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
              class="aspect-[2/3] w-full object-cover"
              loading="lazy"
            />
            <div class="flex flex-1 flex-col p-5">
              <h3 class="text-lg font-semibold text-stone-900 group-hover:underline">
                {book.title}
              </h3>
              {book.subtitle && (
                <p class="mt-1 text-sm font-medium text-stone-500">{book.subtitle}</p>
              )}
              <p class="mt-3 flex-1 text-sm leading-relaxed text-stone-600">
                {book.description}
              </p>
              <span class="mt-4 text-sm font-semibold text-emerald-700">
                Read free online &rarr;
              </span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Author -->
    <section class="mt-20 rounded-2xl bg-white p-8 shadow-sm ring-1 ring-stone-200" aria-labelledby="author-heading">
      <div class="flex flex-col items-center gap-6 text-center sm:flex-row sm:text-left">
        <Image
          src={authorPhoto}
          alt={`Photo of ${author.name}`}
          width={128}
          densities={[1, 2]}
          class="h-32 w-32 shrink-0 rounded-full object-cover object-top ring-2 ring-stone-200"
          loading="lazy"
        />
        <div>
          <h2 id="author-heading" class="text-xl font-semibold text-stone-900">{author.name}</h2>
          <div class="mt-3 max-w-prose space-y-2 leading-relaxed text-stone-600">
            {author.intro.map((line) => <p>{line}</p>)}
            <p>
              {author.contactText}{' '}
              <a
                href={`mailto:${author.email}`}
                data-track="email_click"
                class="font-semibold text-sky-700 hover:underline"
              >
                {author.email}
              </a>
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
