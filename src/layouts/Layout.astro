---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Image for social sharing previews: an imported asset, or a root-relative path */
  ogImage?: ImageMetadata | string;
}

const { title, description, ogImage = '/favicon.svg' } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

// Social scrapers reject very large files, so serve a capped JPEG rather than
// the full-size original.
const ogImagePath =
  typeof ogImage === 'string'
    ? ogImage
    : (await getImage({ src: ogImage, width: 1000, format: 'jpeg', quality: 76 })).src;
const ogImageUrl = new URL(ogImagePath, Astro.site);

// Set PUBLIC_GA_ID in Vercel (Settings → Environment Variables) to enable analytics.
const gaId = import.meta.env.PUBLIC_GA_ID;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap"
    />

    <!-- Social sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {gaId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline define:vars={{ gaId }}>
          // Assigned onto window: Astro wraps `define:vars` scripts in an IIFE,
          // so a bare function declaration would not be reachable from the
          // outbound-click handler below.
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { window.dataLayer.push(arguments); };
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}
  </head>
  <body class="min-h-screen bg-paper font-sans text-[17px] leading-relaxed text-ink antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-10 focus:rounded-full focus:bg-white focus:px-4 focus:py-2">
      Skip to content
    </a>

    <header class="border-b border-line">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-4 gap-y-1 px-5 py-4 sm:px-8">
        <a href="/" class="flex min-h-11 items-center gap-3 text-ink no-underline">
          <svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 3v20" /><path d="M9 9h10" /><path d="M5 17c1 4 5 6 9 6s8-2 9-6" />
          </svg>
          <span class="font-serif text-[22px] font-semibold tracking-tight">Reasons for Christ</span>
        </a>
        <nav aria-label="Main" class="-mx-3 flex flex-wrap">
          <a href="/#books" class="px-3 py-2.5 text-[15px] font-medium text-muted hover:text-ink">Books</a>
          <a href="/trinity/" class="px-3 py-2.5 text-[15px] font-medium text-muted hover:text-ink">Trinity Explained</a>
          <a href="/#about" class="px-3 py-2.5 text-[15px] font-medium text-muted hover:text-ink">About the author</a>
        </nav>
      </div>
    </header>

    <div id="main">
      <slot />
    </div>

    <footer class="border-t border-line">
      <div class="mx-auto flex max-w-6xl flex-col gap-1 px-5 py-8 text-sm text-soft sm:flex-row sm:justify-between sm:px-8">
        <p>&copy; {new Date().getFullYear()} Reasons for Christ</p>
        <p>All books are free to read online.</p>
      </div>
    </footer>

    <!-- Outbound click tracking: any <a data-track="event_name" data-book="slug"> fires a GA event -->
    <script is:inline>
      document.addEventListener('click', function (e) {
        var link = e.target && e.target.closest ? e.target.closest('a[data-track]') : null;
        if (link && typeof window.gtag === 'function') {
          window.gtag('event', link.getAttribute('data-track'), {
            book: link.getAttribute('data-book') || undefined,
          });
        }
      });
    </script>
  </body>
</html>
